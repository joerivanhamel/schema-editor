{
  "name": "RL 09 Author pages (future, off until the bio pages exist)",
  "enabled": false,
  "priority": 15,
  "targets": [
    { "type": "author" },
    { "type": "post_type", "value": "post" }
  ],
  "exclude": [],
  "nodes": [
    {
      "@op": "add",
      "@if": "author.description",
      "@key": "Person",
      "@required": [ "name", "url" ],
      "@type": "Person",
      "@id": "{{author.url}}#person",
      "name": "{{ author.acf.display_name || author.name }}",
      "url": "{{author.url}}",
      "jobTitle": "{{ author.acf.job_title || author.acf.role }}",
      "description": "{{ author.acf.bio || author.description }}",
      "image": "{{ author.acf.headshot|image:large || author.avatar }}",
      "sameAs": [ "{{author.acf.linkedin_url}}" ],
      "worksFor": { "@id": "{{site.url}}#organization" },
      "knowsAbout": "{{author.acf.expertise}}"
    },
    {
      "@op": "merge",
      "@if": "author.description",
      "@match": "@type:ProfilePage",
      "mainEntity": { "@id": "{{author.url}}#person" }
    },
    {
      "@op": "merge",
      "@if": "author.description",
      "@match": "@type:BlogPosting",
      "author": { "@id": "{{author.url}}#person" }
    }
  ]
}

{
  "name": "RL 07 Pages with a film",
  "enabled": true,
  "priority": 10,
  "targets": [
    { "type": "front_page" },
    { "type": "page_template", "value": "page-about.php" },
    { "type": "page_template", "value": "page-meet-the-team.php" },
    { "type": "slug", "value": "process" }
  ],
  "exclude": [],
  "nodes": [
    {
      "@op": "add",
      "@if": "acf.*video_url|youtube_id || acf.*video_id|youtube_id || acf.*youtube_id|youtube_id",
      "@key": "VideoObject",
      "@required": [ "name", "thumbnailUrl", "uploadDate", "embedUrl" ],
      "@type": "VideoObject",
      "@id": "{{post.permalink}}#video",
      "name": "{{ acf.*video_title || acf.*video_label || acf.*film_title || acf.*video_still_alt || post.title }}",
      "description": "{{ acf.*video_description || acf.*film_description || rankmath.description }}",
      "thumbnailUrl": "{{ acf.*video_still|image:1024x576 || acf.*film_still|image:1024x576 || acf.*video_poster|image:1024x576 || post.featured_image }}",
      "uploadDate": "{{post.date}}",
      "duration": "{{ acf.*video_duration|iso_duration || acf.*film_duration|iso_duration }}",
      "embedUrl": "{{ acf.*video_url|youtube_embed || acf.*video_id|youtube_embed || acf.*youtube_id|youtube_embed }}",
      "url": "{{ acf.*video_url|youtube_watch || acf.*video_id|youtube_watch || acf.*youtube_id|youtube_watch }}",
      "publisher": { "@id": "{{site.url}}#organization" },
      "mainEntityOfPage": { "@id": "{{post.permalink}}#webpage" }
    },
    {
      "@op": "merge",
      "@if": "acf.*video_url|youtube_id || acf.*video_id|youtube_id || acf.*youtube_id|youtube_id",
      "@match": "#webpage",
      "video": { "@id": "{{post.permalink}}#video" }
    }
  ]
}

{
  "name": "RL 08 Reviews on the business entity (opt-in, off)",
  "enabled": false,
  "priority": 20,
  "targets": [
    { "type": "front_page" },
    { "type": "page_template", "value": "page-garden-design.php" },
    { "type": "page_template", "value": "page-garden-construction.php" },
    { "type": "page_template", "value": "page-planting-design.php" },
    { "type": "page_template", "value": "page-outdoor-living.php" },
    { "type": "page_template", "value": "page-wellness-gardens.php" },
    { "type": "page_template", "value": "page-garden-maintenance.php" }
  ],
  "exclude": [],
  "nodes": [
    {
      "@op": "merge",
      "@match": "#organization",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "{{option.google_review_score}}",
        "ratingCount": "{{option.google_review_count|int}}",
        "bestRating": "5",
        "worstRating": "1"
      },
      "review": {
        "@each": "option.site_testimonials",
        "@type": "Review",
        "author": { "@type": "Person", "name": "{{item.name}}" },
        "reviewRating": { "@type": "Rating", "ratingValue": "{{item.rating}}", "bestRating": "5", "worstRating": "1" },
        "reviewBody": "{{item.quote}}"
      }
    }
  ]
}

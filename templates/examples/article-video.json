{
  "name": "Articles with a film",
  "enabled": true,
  "priority": 10,
  "targets": [
    { "type": "post_type", "value": "post" }
  ],
  "exclude": [],
  "nodes": [
    {
      "@op": "add",
      "@if": "{{ acf.article_video_url|youtube_id }}",
      "@key": "VideoObject",
      "@required": [ "name", "thumbnailUrl", "uploadDate", "embedUrl" ],
      "@type": "VideoObject",
      "@id": "{{post.permalink}}#video",
      "name": "{{ acf.article_video_title || post.title }}",
      "description": "{{ acf.article_standfirst || rankmath.description || post.excerpt }}",
      "thumbnailUrl": "{{ acf.article_hero_image|image:1024x576 || post.featured_image }}",
      "uploadDate": "{{post.date}}",
      "duration": "{{ acf.*video_duration|iso_duration }}",
      "embedUrl": "{{ acf.article_video_url|youtube_embed }}",
      "url": "{{ acf.article_video_url|youtube_watch }}",
      "publisher": { "@id": "{{site.url}}#organization" },
      "mainEntityOfPage": { "@id": "{{post.permalink}}#webpage" }
    },
    {
      "@op": "merge",
      "@if": "{{ acf.article_video_url|youtube_id }}",
      "@match": "@type:BlogPosting",
      "video": { "@id": "{{post.permalink}}#video" }
    }
  ]
}
